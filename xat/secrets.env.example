# Copy to ~/.config/openclicky/secrets.env and chmod 600. Never commit the real file.

# Brain: Ollama directly (fast). Any key works for Ollama.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENCLICKY_OPENAI_MODEL=qwen3-vl:30b-a3b-instruct

# Voice: local Kokoro (OpenAI-compatible /v1/audio/speech, raw 24 kHz PCM)
OPENCLICKY_LOCAL_TTS_URL=http://127.0.0.1:8880/v1
OPENCLICKY_LOCAL_TTS_VOICE=af_heart

# Control bridge on :32123 - leave UNSET to keep it locked. Only for testing.
# OPENCLICKY_BRIDGE_TOKEN=
